            }
          },
          "required": ["width", "color"],
          "additionalProperties": false
        },
        "lower": {
          "type": "object",
          "properties": {
            "width": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 40,
                  "description": "Width at the start joint."
                },
                {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 40,
                  "description": "Width at the end joint."
                }
              ],
