                    "bone",
                    "slate",
                    "glass",
                    "ochre",
                    "straw",
                    "paint"
                  ]
                }
              },
              "required": ["offset", "size", "color"],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        }
      },
      "required": ["shoulder", "elbow", "wrist", "upper", "lower", "armor"],
      "additionalProperties": false,
      "description": "Right arm in the turret frame; the left arm mirrors it."
    },
    "tools": {
      "type": "object",
      "properties": {
        "barrel": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "position": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "z": { "type": "number" }
                  },
                  "required": ["x", "y", "z"],
                  "additionalProperties": false,
