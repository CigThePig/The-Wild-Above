{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "number", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "Stable ID used by config.mech. Never rename after approval."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "status": {
      "type": "string",
      "enum": ["draft", "approved"],
      "description": "draft: tooling and Rig Lab only. A human approves the silhouette before gameplay use."
    },
    "description": { "type": "string", "maxLength": 600 },
    "paint": {
      "type": "string",
      "enum": ["sand", "bone", "slate", "glass", "ochre", "straw"],
      "description": "Paint colour applied when this Mech is selected."
    },
    "legs": {
      "type": "object",
      "properties": {
        "hipWidth": {
          "type": "number",
          "minimum": 2,
          "maximum": 40,
          "description": "Hip joint distance from the centre line."
        },
        "hipHeight": {
          "type": "number",
          "minimum": 10,
          "maximum": 120,
          "description": "Hip height above ground when standing."
        },
        "thigh": {
          "type": "number",
          "minimum": 5,
          "maximum": 80,
          "description": "Hip-to-knee bone length."
        },
        "shin": {
          "type": "number",
          "minimum": 5,
          "maximum": 80,
          "description": "Knee-to-ankle bone length."
        },
        "ankleHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "Ankle joint height above ground for a planted foot."
        },
        "stance": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "minimum": 2,
              "maximum": 60,
              "description": "Planted foot distance from the centre line."
            },
            "forward": {
              "type": "number",
              "minimum": -20,
              "maximum": 20,
              "description": "Planted foot offset along y (negative is forward)."
            }
          },
          "required": ["width", "forward"],
          "additionalProperties": false
        },
        "stepLift": {
          "type": "number",
          "minimum": 0,
          "maximum": 40,
          "description": "Peak foot lift of a step at stepHeight 1."
        },
        "thighWidth": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0.5,
              "maximum": 40,
              "description": "Width at the start joint."
            },
            {
              "type": "number",
              "minimum": 0.5,
              "maximum": 40,
              "description": "Width at the end joint."
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "description": "Limb widths at its start and end."
        },
        "thighColor": {
          "type": "string",
          "enum": ["sand", "bone", "slate", "glass", "ochre", "straw", "paint"],
          "description": "Palette token (src/mechs/palette.ts), or 'paint' for the live paint colour selected in Rig Lab."
        },
        "shinWidth": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0.5,
              "maximum": 40,
              "description": "Width at the start joint."
            },
            {
              "type": "number",
              "minimum": 0.5,
              "maximum": 40,
              "description": "Width at the end joint."
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "description": "Limb widths at its start and end."
        },
        "shinColor": {
          "type": "string",
          "enum": ["sand", "bone", "slate", "glass", "ochre", "straw", "paint"],
          "description": "Palette token (src/mechs/palette.ts), or 'paint' for the live paint colour selected in Rig Lab."
        },
        "boot": {
          "type": "object",
          "properties": {
            "lift": {
              "type": "number",
              "minimum": -10,
              "maximum": 20,
              "description": "Boot centre height above the ankle joint."
            },
            "size": {
              "type": "object",
              "properties": {
                "w": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 120,
                  "description": "Width along x."
                },
                "d": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 120,
                  "description": "Depth along y."
                },
                "h": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 120,
                  "description": "Height along z."
                }
              },
              "required": ["w", "d", "h"],
              "additionalProperties": false,
              "description": "Bounding box the bevelled octagonal block footprint is cut from."
            },
            "color": {
              "type": "string",
              "enum": [
                "sand",
                "bone",
                "slate",
                "glass",
                "ochre",
                "straw",
                "paint"
              ],
              "description": "Palette token (src/mechs/palette.ts), or 'paint' for the live paint colour selected in Rig Lab."
            },
            "cap": {
              "description": "Top face colour. Omitted: semantic blocks use the side colour; legacy blocks draw no separate cap.",
              "type": "string",
              "enum": [
                "sand",
                "bone",
                "slate",
                "glass",
                "ochre",
                "straw",
                "paint"
              ]
            }
          },
          "required": ["lift", "size", "color"],
          "additionalProperties": false
        },
        "kneecap": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "size": {
                  "type": "object",
                  "properties": {
                    "w": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 120,
                      "description": "Width along x."
                    },
                    "d": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 120,
                      "description": "Depth along y."
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 120,
                      "description": "Height along z."
                    }
                  },
                  "required": ["w", "d", "h"],
                  "additionalProperties": false,
                  "description": "Bounding box the bevelled octagonal block footprint is cut from."
                },
                "color": {
                  "type": "string",
                  "enum": [
                    "sand",
                    "bone",
                    "slate",
                    "glass",
                    "ochre",
                    "straw",
                    "paint"
                  ],
                  "description": "Palette token (src/mechs/palette.ts), or 'paint' for the live paint colour selected in Rig Lab."
                },
                "cap": {
                  "description": "Top face colour. Omitted: semantic blocks use the side colour; legacy blocks draw no separate cap.",
                  "type": "string",
                  "enum": [
                    "sand",
                    "bone",
                    "slate",
                    "glass",
                    "ochre",
                    "straw",
                    "paint"
                  ]
                }
              },
              "required": ["size", "color"],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        }
      },
      "required": [
        "hipWidth",
        "hipHeight",
        "thigh",
        "shin",
        "ankleHeight",
        "stance",
        "stepLift",
        "thighWidth",
        "thighColor",
        "shinWidth",
        "shinColor",
        "boot",
        "kneecap"
      ],
      "additionalProperties": false
    },
    "gait": {
      "type": "object",
      "properties": {
        "walkSpeed": {
          "type": "number",
          "minimum": 10,
          "maximum": 200,
          "description": "Walking speed in units per second."
        },
        "runSpeed": {
          "type": "number",
          "minimum": 10,
          "maximum": 300,
          "description": "Running speed in units per second."
        },
        "turnRate": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 8,
          "description": "Body turn rate in radians per second."
        },
        "stepDuration": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1,
          "description": "Walking swing duration in seconds."
        },
        "runStepDuration": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1,
          "description": "Running swing duration in seconds."
        },
        "runStepAbove": {
          "type": "number",
          "minimum": 0,
          "maximum": 300,
          "description": "Speed above which runStepDuration applies."
        },
        "bob": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Body rise during a swing at bob 1."
        },
        "landDip": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Body dip when a foot lands."
        }
      },
      "required": [
        "walkSpeed",
        "runSpeed",
        "turnRate",
        "stepDuration",
        "runStepDuration",
        "runStepAbove",
        "bob",
        "landDip"
      ],
      "additionalProperties": false
    },
    "pelvis": {
      "type": "object",
      "properties": {
        "position": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "required": ["x", "y", "z"],
          "additionalProperties": false,
          "description": "Offset in the attachment frame, in Mech units: x right (outward for mirrored or per-side parts), y back (+) / front (−), z up."
        },
        "size": {
          "type": "object",
          "properties": {
            "w": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 120,
              "description": "Width along x."
            },
            "d": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 120,
              "description": "Depth along y."
            },
            "h": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 120,
              "description": "Height along z."
            }
          },
          "required": ["w", "d", "h"],
          "additionalProperties": false,
          "description": "Bounding box the bevelled octagonal block footprint is cut from."
        },
        "color": {
          "type": "string",
          "enum": ["sand", "bone", "slate", "glass", "ochre", "straw", "paint"],
          "description": "Palette token (src/mechs/palette.ts), or 'paint' for the live paint colour selected in Rig Lab."
        },
        "cap": {
          "description": "Top face colour. Omitted: semantic blocks use the side colour; legacy blocks draw no separate cap.",
          "type": "string",
          "enum": ["sand", "bone", "slate", "glass", "ochre", "straw", "paint"]
        }
      },
      "required": ["position", "size", "color"],
      "additionalProperties": false,
      "description": "Body frame block at the hips."
    },
    "turret": {
      "type": "object",
      "properties": {
        "height": {
          "type": "number",
          "minimum": 10,
          "maximum": 200,
          "description": "Upper-body frame origin height when the hips are at hipHeight."
        }
      },
      "required": ["height"],
      "additionalProperties": false
    },
    "torso": {
      "type": "object",
      "properties": {
        "size": {
          "type": "object",
          "properties": {
            "w": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 120,
              "description": "Width along x."
            },
            "d": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 120,
              "description": "Depth along y."
            },
            "h": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 120,
              "description": "Height along z."
            }
          },
          "required": ["w", "d", "h"],
          "additionalProperties": false,
          "description": "Bounding box the bevelled octagonal block footprint is cut from."
        },
        "color": {
          "type": "string",
          "enum": ["sand", "bone", "slate", "glass", "ochre", "straw", "paint"],
          "description": "Palette token (src/mechs/palette.ts), or 'paint' for the live paint colour selected in Rig Lab."
        },
        "cap": {
          "description": "Top face colour. Omitted: semantic blocks use the side colour; legacy blocks draw no separate cap.",
          "type": "string",
          "enum": ["sand", "bone", "slate", "glass", "ochre", "straw", "paint"]
        }
      },
      "required": ["size", "color"],
      "additionalProperties": false,
      "description": "Turret frame block centred on the upper-body origin."
    },
    "pack": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "position": {
              "type": "object",
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "z": { "type": "number" }
              },
              "required": ["x", "y", "z"],
              "additionalProperties": false,
              "description": "Offset in the attachment frame, in Mech units: x right (outward for mirrored or per-side parts), y back (+) / front (−), z up."
            },
            "size": {
              "type": "object",
              "properties": {
                "w": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 120,
                  "description": "Width along x."
                },
                "d": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 120,
                  "description": "Depth along y."
                },
                "h": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 120,
                  "description": "Height along z."
                }
              },
              "required": ["w", "d", "h"],
              "additionalProperties": false,
              "description": "Bounding box the bevelled octagonal block footprint is cut from."
            },
            "color": {
              "type": "string",
              "enum": [
                "sand",
                "bone",
                "slate",
                "glass",
                "ochre",
                "straw",
                "paint"
              ],
              "description": "Palette token (src/mechs/palette.ts), or 'paint' for the live paint colour selected in Rig Lab."
            },
            "cap": {
              "description": "Top face colour. Omitted: semantic blocks use the side colour; legacy blocks draw no separate cap.",
              "type": "string",
              "enum": [
                "sand",
                "bone",
                "slate",
                "glass",
                "ochre",
                "straw",
                "paint"
              ]
            }
          },
          "required": ["position", "size", "color"],
          "additionalProperties": false
        },
        { "type": "null" }
      ],
      "description": "Turret frame block, usually behind."
    },
    "cockpit": {
      "type": "object",
      "properties": {
        "position": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "required": ["x", "y", "z"],
          "additionalProperties": false,
          "description": "Offset in the attachment frame, in Mech units: x right (outward for mirrored or per-side parts), y back (+) / front (−), z up."
        },
        "size": {
          "type": "object",
          "properties": {
            "w": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 120,
              "description": "Width along x."
            },
            "d": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 120,
              "description": "Depth along y."
            },
            "h": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 120,
              "description": "Height along z."
            }
          },
          "required": ["w", "d", "h"],
          "additionalProperties": false,
          "description": "Bounding box the bevelled octagonal block footprint is cut from."
        },
        "color": {
          "type": "string",
          "enum": ["sand", "bone", "slate", "glass", "ochre", "straw", "paint"],
          "description": "Palette token (src/mechs/palette.ts), or 'paint' for the live paint colour selected in Rig Lab."
        },
        "cap": {
          "description": "Top face colour. Omitted: semantic blocks use the side colour; legacy blocks draw no separate cap.",
          "type": "string",
          "enum": ["sand", "bone", "slate", "glass", "ochre", "straw", "paint"]
        }
      },
      "required": ["position", "size", "color"],
      "additionalProperties": false,
      "description": "Turret frame housing. Boarding choreography is fixed: keep it near the standard cockpit (mech:check enforces this)."
    },
    "canopy": {
      "type": "object",
      "properties": {
        "halfWidth": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 40,
          "description": "Half width when facing the viewer."
        },
        "front": {
          "type": "number",
          "description": "Canopy plane y in the turret frame."
        },
        "top": { "type": "number", "description": "Top edge z." },
        "bottom": {
          "type": "number",
          "description": "Bottom edge z when closed."
        },
        "open": {
          "type": "object",
          "properties": {
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "required": ["y", "z"],
          "additionalProperties": false,
          "description": "Bottom edge travel when the hatch is fully open."
        },
        "color": {
          "type": "string",
          "enum": ["sand", "bone", "slate", "glass", "ochre", "straw", "paint"],
          "description": "Palette token (src/mechs/palette.ts), or 'paint' for the live paint colour selected in Rig Lab."
        }
      },
      "required": ["halfWidth", "front", "top", "bottom", "open", "color"],
      "additionalProperties": false
    },
