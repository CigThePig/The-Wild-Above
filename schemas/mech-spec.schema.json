            }
          },
          "required": ["width", "color"],
          "additionalProperties": false
        },
        "armor": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "offset": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "number" },
