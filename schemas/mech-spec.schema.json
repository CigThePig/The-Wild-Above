            "z": { "type": "number" }
          },
          "required": ["x", "y", "z"],
          "additionalProperties": false,
          "description": "Offset in the attachment frame, in Mech units: x right (outward for mirrored or per-side parts), y back (+) / front (−), z up."
        },
        "wrist": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "required": ["x", "y", "z"],
          "additionalProperties": false,
          "description": "Offset in the attachment frame, in Mech units: x right (outward for mirrored or per-side parts), y back (+) / front (−), z up."
        },
        "upper": {
